@inject NavigationManager Nav

<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>404 - Level Not Found | SpriteSync</PageTitle>
        <LayoutView Layout="@typeof(MainLayout)">
            <div class="max-w-2xl mx-auto px-6 py-20 text-center text-slate-100">
                <div class="w-20 h-20 mx-auto mb-6 rounded-3xl bg-indigo-500/10 border border-indigo-500/30 flex items-center justify-center text-4xl shadow-inner shadow-indigo-500/20" aria-hidden="true">
                    👾
                </div>
                <span class="text-xs font-mono font-bold uppercase tracking-wider text-indigo-400 bg-indigo-500/10 px-3 py-1 rounded-full border border-indigo-500/20">
                    Error 404 • Area Undefined
                </span>
                <h1 class="text-3xl md:text-4xl font-black mt-4 mb-3 tracking-tight">Level Not Found</h1>
                <p class="text-slate-400 text-sm max-w-md mx-auto mb-8">
                    The asset, spritesheet, or page you are seeking has despawned or been moved to a different coordinate.
                </p>

                <form @onsubmit="NavigateSearch" class="max-w-md mx-auto mb-6 flex gap-2">
                    <input type="text" @bind="SearchTerm" @bind:event="oninput" placeholder="Search marketplace assets..." aria-label="Search marketplace assets"
                           class="flex-1 bg-slate-950 border border-slate-800 rounded-xl px-4 py-2.5 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500 focus-visible:ring-2 focus-visible:ring-indigo-500" />
                    <button type="submit" class="bg-indigo-600 hover:bg-indigo-500 text-white px-4 py-2.5 rounded-xl text-xs font-bold transition-all shadow-md">
                        Search
                    </button>
                </form>

                <a href="/" class="inline-flex items-center gap-2 text-xs font-bold text-slate-300 hover:text-white transition-colors">
                    <span aria-hidden="true">←</span> Return to Marketplace
                </a>
            </div>
        </LayoutView>
    </NotFound>
</Router>

@code {
    private string SearchTerm { get; set; } = "";

    private void NavigateSearch() =>
        Nav.NavigateTo(string.IsNullOrWhiteSpace(SearchTerm) ? "/" : $"/?q={Uri.EscapeDataString(SearchTerm)}");
}

@page "/"
@inherits CartAwareComponent
@inject AssetService Assets
@inject NavigationManager Nav

<PageTitle>SpriteSync | 2D Asset Marketplace</PageTitle>

<div class="max-w-7xl mx-auto px-6 py-6 text-slate-100">

    <!-- Hero / Featured Banner -->
    <div class="relative overflow-hidden rounded-3xl bg-gradient-to-r from-slate-900 via-indigo-950/60 to-slate-900 border border-slate-800/80 p-8 md:p-10 mb-8 shadow-2xl flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="relative z-10 max-w-xl">
            <span class="inline-flex items-center gap-1.5 bg-indigo-500/10 text-indigo-400 border border-indigo-500/20 text-xs font-mono font-bold px-3 py-1 rounded-full mb-4">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                COMMUNITY MARKETPLACE • 100% ROYALTY-FREE
            </span>
            <h1 class="text-3xl md:text-5xl font-black tracking-tight text-white mb-3">
                Handcrafted 2D Assets for Indie Developers
            </h1>
            <p class="text-slate-400 text-sm md:text-base leading-relaxed mb-6">
                Direct export to Godot, Unity, and GameMaker. Test full animation states in browser with verified commercial licensing.
            </p>
            <div class="flex flex-wrap gap-3 mb-6">
                <a href="#market-grid" class="bg-indigo-600 hover:bg-indigo-500 active:scale-95 text-white font-bold px-5 py-2.5 rounded-xl text-xs transition-all shadow-md">
                    Browse Assets
                </a>
                <a href="/vault?tab=vault" class="bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 font-bold px-5 py-2.5 rounded-xl text-xs transition-all">
                    Sell Your Assets
                </a>
            </div>
            <div class="flex flex-wrap gap-4 text-xs font-medium text-slate-300">
                <div class="flex items-center gap-1.5"><span class="text-indigo-400">✓</span> Instant .ASEPRITE &amp; .PNG</div>
                <div class="flex items-center gap-1.5"><span class="text-indigo-400">✓</span> Verified Commercial Rights</div>
                <div class="flex items-center gap-1.5"><span class="text-indigo-400">✓</span> Zero Runtime Fees</div>
            </div>
        </div>

        <!-- Hero Pixel Art Showcase Preview -->
        <div class="relative w-full max-w-xs aspect-square bg-slate-950/70 border border-slate-800 rounded-3xl p-6 flex flex-col items-center justify-center shadow-2xl">
            <div class="w-32 h-32 rounded-2xl bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center relative overflow-hidden">
                <div class="w-16 h-16 transform scale-150" style="background-image: url('/images/sprites/cyberpunk-sheet.svg'); background-repeat: no-repeat; background-position: 0 0; image-rendering: pixelated;"></div>
            </div>
            <span class="mt-3 text-xs font-mono font-bold text-indigo-400">Cyberpunk Hero • 64x64</span>
            <span class="text-slate-400 text-xs">Canvas tester ready</span>
        </div>
    </div>

    <!-- Sticky Filter & Search Bar -->
    <div id="market-grid" class="sticky top-16 z-30 bg-slate-900/95 backdrop-blur-xl border border-slate-800 rounded-2xl p-4 mb-6 space-y-4 shadow-xl">
        <div class="flex flex-col md:flex-row gap-3 justify-between items-center">

            <!-- Category Tabs -->
            <div class="flex gap-1.5 overflow-x-auto w-full md:w-auto pb-1 md:pb-0 text-xs font-semibold">
                @foreach (var cat in new[] { "All", "Spritesheet", "Tileset", "UI Pack", "SFX" })
                {
                    var c = cat;
                    <button type="button" @onclick="() => SetCategory(c)"
                            class="px-3.5 py-2 rounded-xl transition-all whitespace-nowrap @(SelectedCategory == c ? "bg-indigo-600 text-white shadow" : "bg-slate-800/60 text-slate-300 hover:text-white hover:bg-slate-800")"
                            aria-pressed="@(SelectedCategory == c ? "true" : "false")">
                        @c
                    </button>
                }
            </div>

            <div class="flex gap-2 w-full md:w-auto">
                <div class="relative flex-1 md:w-72">
                    <input type="text" placeholder="Search sprites, tags, creators..." aria-label="Search assets"
                           value="@SearchQuery" @oninput="OnSearchInput"
                           class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2 pl-9 focus:outline-none focus:border-indigo-500 transition-colors text-xs text-white placeholder-slate-400" />
                    <svg class="w-4 h-4 text-slate-400 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                </div>

                <button type="button" @onclick="() => ShowMobileFilters = !ShowMobileFilters"
                        aria-expanded="@(ShowMobileFilters ? "true" : "false")"
                        class="md:hidden bg-slate-800 hover:bg-slate-700 text-white px-3 py-2 rounded-xl text-xs font-bold border border-slate-700">
                    Filters
                </button>
            </div>
        </div>

        <!-- Secondary Filters Row -->
        <div class="@(ShowMobileFilters ? "flex" : "hidden md:flex") flex-wrap items-center justify-between gap-3 pt-3 border-t border-slate-800/80 text-xs">
            <div class="flex flex-wrap items-center gap-4">
                <div class="flex items-center gap-1.5 flex-wrap">
                    <span class="text-slate-400 font-medium">Style:</span>
                    @foreach (var style in new[] { "All", "Pixel Art", "Vector", "Chiptune / Synth" })
                    {
                        var s = style;
                        <button type="button" @onclick="() => SetStyle(s)"
                                class="px-2.5 py-1 rounded-lg transition-colors @(SelectedStyle == s ? "bg-slate-700 text-white font-bold" : "text-slate-300 hover:text-white")">
                            @s
                        </button>
                    }
                </div>

                <div class="flex items-center gap-1.5 flex-wrap">
                    <span class="text-slate-400 font-medium">Res:</span>
                    @foreach (var res in new[] { "All", "16x16", "32x32", "64x64" })
                    {
                        var rr = res;
                        <button type="button" @onclick="() => SetResolution(rr)"
                                class="px-2 py-0.5 rounded text-xs transition-colors @(SelectedResolution == rr ? "bg-indigo-600/30 text-indigo-300 font-bold border border-indigo-500/40" : "text-slate-300 hover:text-white")">
                            @rr
                        </button>
                    }
                </div>
            </div>

            <div class="flex items-center gap-3 flex-wrap">
                <div class="flex bg-slate-950 p-0.5 rounded-lg border border-slate-800">
                    <button type="button" @onclick='() => SetPriceTier("all")' class="px-2.5 py-1 rounded-md text-xs font-medium @(PriceTier == "all" ? "bg-slate-800 text-white" : "text-slate-400 hover:text-white")">All</button>
                    <button type="button" @onclick='() => SetPriceTier("under15")' class="px-2.5 py-1 rounded-md text-xs font-medium @(PriceTier == "under15" ? "bg-slate-800 text-emerald-400 font-bold" : "text-slate-400 hover:text-white")">&lt; $15</button>
                    <button type="button" @onclick='() => SetPriceTier("15to25")' class="px-2.5 py-1 rounded-md text-xs font-medium @(PriceTier == "15to25" ? "bg-slate-800 text-white" : "text-slate-400 hover:text-white")">$15–$25</button>
                    <button type="button" @onclick='() => SetPriceTier("above25")' class="px-2.5 py-1 rounded-md text-xs font-medium @(PriceTier == "above25" ? "bg-slate-800 text-white" : "text-slate-400 hover:text-white")">$25+</button>
                </div>

                <select value="@SortOrder" @onchange="OnSortChanged" aria-label="Sort assets"
                        class="bg-slate-950 border border-slate-800 text-slate-200 text-xs rounded-lg px-2.5 py-1.5 focus:outline-none focus:border-indigo-500">
                    <option value="featured">Featured</option>
                    <option value="price-asc">Price: Low to High</option>
                    <option value="price-desc">Price: High to Low</option>
                    <option value="rating">Top Rated</option>
                    <option value="downloads">Most Downloaded</option>
                </select>
            </div>
        </div>

        <!-- Result Counter -->
        <div class="flex flex-wrap items-center justify-between gap-3 pt-3 border-t border-slate-800/80 text-xs">
            <div class="text-slate-400" aria-live="polite">
                Showing <strong class="text-white">@Filtered.Count</strong> of @AllAssets.Count @(AllAssets.Count == 1 ? "asset" : "assets")
            </div>

            @if (HasActiveFilters)
            {
                <button type="button" @onclick="ResetFilters" class="text-indigo-400 hover:text-indigo-300 font-bold underline">
                    Clear all filters
                </button>
            }
        </div>
    </div>

    <!-- Asset Cards Responsive Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        @foreach (var asset in Filtered)
        {
            <AssetCard @key="asset.Id" Item="asset" OnAddToCart="HandleAddToCart" />
        }
    </div>

    @if (Filtered.Count == 0)
    {
        <div class="text-center py-20 bg-slate-900/40 rounded-3xl border border-slate-800 mt-6">
            <p class="text-slate-300 text-base font-semibold">No assets found matching your criteria</p>
            <p class="text-slate-400 text-xs mt-1 mb-4">Try resetting the category, art style, or price tier filters.</p>
            <button type="button" @onclick="ResetFilters" class="bg-indigo-600 hover:bg-indigo-500 text-white px-4 py-2 rounded-xl text-xs font-bold">
                Reset All Filters
            </button>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "q")] public string? QueryQ { get; set; }
    [SupplyParameterFromQuery(Name = "cat")] public string? QueryCat { get; set; }
    [SupplyParameterFromQuery(Name = "style")] public string? QueryStyle { get; set; }
    [SupplyParameterFromQuery(Name = "price")] public string? QueryPrice { get; set; }
    [SupplyParameterFromQuery(Name = "res")] public string? QueryRes { get; set; }
    [SupplyParameterFromQuery(Name = "sort")] public string? QuerySort { get; set; }

    private string SearchQuery { get; set; } = "";
    private string SelectedCategory { get; set; } = "All";
    private string SelectedStyle { get; set; } = "All";
    private string SelectedResolution { get; set; } = "All";
    private string PriceTier { get; set; } = "all";
    private string SortOrder { get; set; } = "featured";
    private bool ShowMobileFilters { get; set; }

    private IReadOnlyList<Asset> AllAssets = new List<Asset>();
    private CancellationTokenSource? _debounceCts;
    private string? _lastSyncedUrl;

    private bool HasActiveFilters => SelectedCategory != "All" || SelectedStyle != "All" || SelectedResolution != "All"
                                     || PriceTier != "all" || !string.IsNullOrWhiteSpace(SearchQuery);

    protected override void OnInitialized()
    {
        base.OnInitialized();
        AllAssets = Assets.GetAll();
    }

    protected override void OnParametersSet()
    {
        // Ignore the navigation we triggered ourselves in SyncUrl (avoids clobbering in-flight typing).
        if (_lastSyncedUrl != null && string.Equals(Nav.Uri, _lastSyncedUrl, StringComparison.Ordinal)) return;

        SearchQuery = QueryQ ?? "";
        SelectedCategory = string.IsNullOrWhiteSpace(QueryCat) ? "All" : QueryCat;
        SelectedStyle = string.IsNullOrWhiteSpace(QueryStyle) ? "All" : QueryStyle;
        PriceTier = string.IsNullOrWhiteSpace(QueryPrice) ? "all" : QueryPrice;
        SelectedResolution = string.IsNullOrWhiteSpace(QueryRes) ? "All" : QueryRes;
        SortOrder = string.IsNullOrWhiteSpace(QuerySort) ? "featured" : QuerySort;
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        SearchQuery = e.Value?.ToString() ?? "";
        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
        var cts = _debounceCts = new CancellationTokenSource();
        _ = DebouncedSync(cts.Token);
    }

    private async Task DebouncedSync(CancellationToken token)
    {
        try
        {
            await Task.Delay(250, token);
            await InvokeAsync(SyncUrl);
        }
        catch (OperationCanceledException) { }
        catch (ObjectDisposedException) { }
    }

    private void OnSortChanged(ChangeEventArgs e) { SortOrder = e.Value?.ToString() ?? "featured"; SyncUrl(); }
    private void SetCategory(string cat) { SelectedCategory = cat; SyncUrl(); }
    private void SetStyle(string s) { SelectedStyle = s; SyncUrl(); }
    private void SetResolution(string r) { SelectedResolution = r; SyncUrl(); }
    private void SetPriceTier(string p) { PriceTier = p; SyncUrl(); }

    private void ResetFilters()
    {
        SearchQuery = "";
        SelectedCategory = "All";
        SelectedStyle = "All";
        SelectedResolution = "All";
        PriceTier = "all";
        SortOrder = "featured";
        SyncUrl();
    }

    private void SyncUrl()
    {
        var url = Nav.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["q"] = string.IsNullOrWhiteSpace(SearchQuery) ? null : SearchQuery,
            ["cat"] = SelectedCategory == "All" ? null : SelectedCategory,
            ["style"] = SelectedStyle == "All" ? null : SelectedStyle,
            ["price"] = PriceTier == "all" ? null : PriceTier,
            ["res"] = SelectedResolution == "All" ? null : SelectedResolution,
            ["sort"] = SortOrder == "featured" ? null : SortOrder
        });
        _lastSyncedUrl = url;
        Nav.NavigateTo(url, replace: true);
    }

    private void HandleAddToCart(Asset asset) => Cart.AddToCart(asset);

    private List<Asset> Filtered
    {
        get
        {
            var q = AllAssets
                .Where(a => string.IsNullOrWhiteSpace(SearchQuery) ||
                            a.Name.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ||
                            a.Creator.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ||
                            a.Category.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ||
                            a.Tags.Any(t => t.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)))
                .Where(a => SelectedCategory == "All" || a.Category.Equals(SelectedCategory, StringComparison.OrdinalIgnoreCase))
                .Where(a => SelectedStyle == "All" || a.ArtStyle.Equals(SelectedStyle, StringComparison.OrdinalIgnoreCase))
                .Where(a => SelectedResolution == "All" || a.Resolution.Equals(SelectedResolution, StringComparison.OrdinalIgnoreCase))
                .Where(a => PriceTier switch
                {
                    "under15" => a.BasePrice < 15.00m,
                    "15to25" => a.BasePrice >= 15.00m && a.BasePrice <= 25.00m,
                    "above25" => a.BasePrice > 25.00m,
                    _ => true
                });

            IEnumerable<Asset> sorted = SortOrder switch
            {
                "price-asc" => q.OrderBy(a => a.BasePrice),
                "price-desc" => q.OrderByDescending(a => a.BasePrice),
                "rating" => q.OrderByDescending(a => a.Rating),
                "downloads" => q.OrderByDescending(a => a.Downloads),
                _ => q.OrderByDescending(a => a.IsStaffPick).ThenByDescending(a => a.Rating)
            };
            return sorted.ToList();
        }
    }

    public override void Dispose()
    {
        base.Dispose();
        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
    }
}

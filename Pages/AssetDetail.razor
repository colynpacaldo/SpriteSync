@page "/asset/{Id:int}"
@inject CartStateService Cart

<div class="max-w-7xl mx-auto p-6 text-slate-100 min-h-[80vh]">
    <a href="/" class="inline-flex items-center gap-2 text-slate-400 hover:text-white mb-6 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
        Back to Market
    </a>

    <div class="lg:grid lg:grid-cols-12 gap-8 relative">
        <div class="lg:col-span-7 space-y-6">
            <!-- Interactive Canvas Area -->
            <div class="bg-slate-800 rounded-2xl border border-slate-700 aspect-video flex flex-col items-center justify-center p-4 relative overflow-hidden group">
                <div class="absolute inset-0 opacity-10 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-indigo-500 via-slate-900 to-slate-900"></div>
                <div class="z-10 flex flex-col items-center gap-4">
                    <svg class="w-16 h-16 text-slate-600 group-hover:text-indigo-500 transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    <p class="text-slate-400 font-medium">Interactive Canvas Demo Preview</p>
                </div>
            </div>
            
            <div class="bg-slate-800 p-8 rounded-2xl border border-slate-700">
                <h3 class="text-2xl font-bold mb-4">Package Contents</h3>
                <ul class="list-disc list-inside text-slate-400 space-y-2">
                    <li>32x32px Character Sprites</li>
                    <li>Source .aseprite files included</li>
                    <li>24 Animation states (Idle, Run, Jump, Attack)</li>
                    <li>Optimized spritesheets ready for Unity & Godot</li>
                </ul>
            </div>
        </div>

        <div class="lg:col-span-5 relative mt-8 lg:mt-0">
            <div class="sticky top-24 bg-slate-900/80 backdrop-blur-xl border border-slate-700 p-8 rounded-3xl shadow-2xl">
                <div class="flex justify-between items-start mb-2">
                    <h1 class="text-3xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 to-cyan-400">Asset Pack #@Id</h1>
                </div>
                <p class="text-slate-400 mb-8 border-b border-slate-800 pb-4">By PixelForge Studio</p>

                <div class="space-y-4 mb-8">
                    <div @onclick="() => SelectLicense(false)" class="cursor-pointer p-5 rounded-2xl border-2 transition-all duration-200 @(!IsCommercial ? "border-indigo-500 bg-indigo-500/10 shadow-[0_0_15px_rgba(99,102,241,0.15)]" : "border-slate-800 bg-slate-800/50 hover:border-slate-600")">
                        <div class="flex justify-between items-center">
                            <span class="font-bold text-xl text-white">Personal</span>
                            <span class="text-xl font-black text-white">$15.00</span>
                        </div>
                        <p class="text-sm text-slate-400 mt-2">For non-commercial indie projects and learning.</p>
                    </div>

                    <div @onclick="() => SelectLicense(true)" class="cursor-pointer p-5 rounded-2xl border-2 transition-all duration-200 @(IsCommercial ? "border-indigo-500 bg-indigo-500/10 shadow-[0_0_15px_rgba(99,102,241,0.15)]" : "border-slate-800 bg-slate-800/50 hover:border-slate-600")">
                        <div class="flex justify-between items-center">
                            <span class="font-bold text-xl @(IsCommercial ? "text-indigo-400" : "text-white")">Commercial</span>
                            <span class="text-xl font-black @(IsCommercial ? "text-indigo-400" : "text-white")">$45.00</span>
                        </div>
                        <p class="text-sm text-slate-400 mt-2">Unlimited commercial usage & modifiable source files.</p>
                    </div>
                </div>

                <button @onclick="AddToCart" class="w-full bg-indigo-600 hover:bg-indigo-500 text-white font-black text-lg py-4 rounded-2xl shadow-[0_0_20px_rgba(99,102,241,0.4)] transition-all active:scale-95 flex justify-center items-center gap-3">
                    Add to Cart - $@(CurrentPrice)
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public int Id { get; set; }
    
    private bool IsCommercial { get; set; } = false;
    private decimal BasePrice = 15.00m;
    private decimal CurrentPrice => IsCommercial ? BasePrice * 3 : BasePrice;

    private void SelectLicense(bool commercial) => IsCommercial = commercial;

    private void AddToCart()
    {
        var dummyAsset = new Asset { Id = this.Id, Name = $"Asset Pack #{Id} ({(IsCommercial ? "Commercial" : "Personal")})", BasePrice = CurrentPrice };
        Cart.AddToCart(dummyAsset);
    }
}
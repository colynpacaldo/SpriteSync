@page "/asset/{Id:int}"
@inherits CartAwareComponent
@inject AssetService Assets

<PageTitle>@(CurrentAsset?.Name ?? "Asset Not Found") | SpriteSync</PageTitle>

@if (CurrentAsset == null)
{
    <div class="max-w-4xl mx-auto px-6 py-20 text-center text-slate-100">
        <div class="text-4xl mb-3" aria-hidden="true">🔍</div>
        <h1 class="text-2xl font-black mb-2">Asset Not Found</h1>
        <p class="text-slate-400 text-sm mb-6">The requested asset #@Id does not exist in the catalog.</p>
        <a href="/" class="inline-block bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-xs px-5 py-2.5 rounded-xl transition-all shadow">
            ← Return to Marketplace
        </a>
    </div>
}
else
{
    <div class="max-w-7xl mx-auto px-6 py-6 text-slate-100 min-h-[85vh] pb-24 lg:pb-12">
        <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs text-slate-400 mb-6">
            <a href="/" class="hover:text-white transition-colors">Marketplace</a>
            <span aria-hidden="true">/</span>
            <span class="text-slate-300">@CurrentAsset.Category</span>
            <span aria-hidden="true">/</span>
            <span class="text-indigo-400 font-semibold" aria-current="page">@CurrentAsset.Name</span>
        </nav>

        <div class="lg:grid lg:grid-cols-12 gap-8 relative">

            <!-- Left column -->
            <div class="lg:col-span-7 space-y-6">
                <SpriteAnimator @key="CurrentAsset.Id" Asset="CurrentAsset" />

                <div class="bg-slate-900 border border-slate-800 p-6 rounded-3xl">
                    <h2 class="text-base font-bold text-white mb-4">Package Specifications</h2>
                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs">
                        <div class="bg-slate-950 p-3 rounded-xl border border-slate-800/80"><div class="text-slate-400">Grid Size</div><div class="text-white font-mono font-bold mt-1">@CurrentAsset.Dimensions</div></div>
                        <div class="bg-slate-950 p-3 rounded-xl border border-slate-800/80"><div class="text-slate-400">Total Frames</div><div class="text-white font-mono font-bold mt-1">@CurrentAsset.FrameCount</div></div>
                        <div class="bg-slate-950 p-3 rounded-xl border border-slate-800/80"><div class="text-slate-400">Version</div><div class="text-emerald-400 font-mono font-bold mt-1">@CurrentAsset.Version</div></div>
                        <div class="bg-slate-950 p-3 rounded-xl border border-slate-800/80"><div class="text-slate-400">Engines</div><div class="text-indigo-300 font-mono font-bold mt-1">@string.Join(", ", CurrentAsset.CompatibleEngines)</div></div>
                    </div>
                </div>

                <!-- Tabs -->
                <div class="bg-slate-900 border border-slate-800 rounded-3xl p-6">
                    <div class="flex border-b border-slate-800 gap-4 mb-4 text-xs font-bold" role="tablist">
                        @foreach (var tab in Tabs)
                        {
                            var t = tab;
                            <button type="button" role="tab" aria-selected="@(ActiveTab == t ? "true" : "false")"
                                    @onclick="() => ActiveTab = t"
                                    class="pb-2 border-b-2 transition-colors @(ActiveTab == t ? "border-indigo-500 text-white" : "border-transparent text-slate-400 hover:text-slate-200")">
                                @(t == "Reviews" ? $"Reviews ({CurrentAsset.Reviews.Count})" : t)
                            </button>
                        }
                    </div>

                    @if (ActiveTab == "Overview")
                    {
                        <div class="space-y-4 text-xs leading-relaxed text-slate-300">
                            <p>@CurrentAsset.Description</p>
                            <div class="flex flex-wrap gap-1.5 pt-2">
                                @foreach (var tag in CurrentAsset.Tags)
                                {
                                    <span class="bg-slate-950 border border-slate-800 text-slate-300 px-2.5 py-1 rounded-md">#@tag</span>
                                }
                            </div>
                        </div>
                    }
                    else if (ActiveTab == "Reviews")
                    {
                        <div class="space-y-3">
                            @if (CurrentAsset.Reviews.Count == 0)
                            {
                                <p class="text-xs text-slate-400">No reviews yet.</p>
                            }
                            @foreach (var rev in CurrentAsset.Reviews)
                            {
                                <div class="p-3 bg-slate-950 border border-slate-800 rounded-xl text-xs">
                                    <div class="flex justify-between items-center mb-1">
                                        <span class="font-bold text-white">@rev.Author</span>
                                        <span class="text-amber-400" aria-label="@rev.Rating out of 5 stars">@(new string('★', Math.Clamp(rev.Rating, 0, 5)))</span>
                                    </div>
                                    <p class="text-slate-300">@rev.Comment</p>
                                    <div class="text-slate-400 text-xs mt-1">@rev.Date</div>
                                </div>
                            }
                        </div>
                    }
                    else if (ActiveTab == "Changelog")
                    {
                        <div class="p-4 bg-slate-950 border border-slate-800 rounded-xl text-xs">
                            <div class="font-bold text-indigo-400 font-mono mb-1">@CurrentAsset.Version Release</div>
                            <p class="text-slate-300">@CurrentAsset.VersionNotes</p>
                        </div>
                    }
                    else if (ActiveTab == "FAQ")
                    {
                        <div class="space-y-3 text-xs">
                            <div class="p-3 bg-slate-950 border border-slate-800 rounded-xl">
                                <strong class="text-white block mb-1">Can I use these assets in a commercial Steam game?</strong>
                                <span class="text-slate-300">Yes! The Commercial Unlimited license grants royalty-free distribution in commercial products with zero runtime fees.</span>
                            </div>
                            <div class="p-3 bg-slate-950 border border-slate-800 rounded-xl">
                                <strong class="text-white block mb-1">Are source .aseprite files provided?</strong>
                                <span class="text-slate-300">Commercial purchases include .aseprite layered source files alongside PNG sprite sheets.</span>
                            </div>
                        </div>
                    }
                </div>

                <!-- License Comparison -->
                <div class="bg-slate-900 border border-slate-800 p-6 rounded-3xl">
                    <h2 class="text-base font-bold text-white mb-3">License Comparison</h2>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-xs">
                            <thead class="text-slate-400 border-b border-slate-800">
                                <tr>
                                    <th class="py-2">Feature Rights</th>
                                    <th class="py-2 text-center">Personal</th>
                                    <th class="py-2 text-center text-indigo-300">Commercial</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-800 text-slate-300">
                                <tr><td class="py-2">Non-commercial &amp; Game Jams</td><td class="text-center text-emerald-400">✓</td><td class="text-center text-emerald-400">✓</td></tr>
                                <tr><td class="py-2">Commercial Releases (Steam, Console)</td><td class="text-center text-slate-400">✕</td><td class="text-center text-emerald-400">✓</td></tr>
                                <tr><td class="py-2">Monetized Mobile Releases</td><td class="text-center text-slate-400">✕</td><td class="text-center text-emerald-400">✓</td></tr>
                                <tr><td class="py-2">Source .ASEPRITE / Vector Files</td><td class="text-center text-slate-400">✕</td><td class="text-center text-emerald-400">✓</td></tr>
                                <tr><td class="py-2">Zero Runtime Royalty Fees</td><td class="text-center text-emerald-400">✓</td><td class="text-center text-emerald-400">✓</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Right: sticky purchase picker -->
            <div class="lg:col-span-5 relative">
                <div class="sticky top-20 bg-slate-900/95 backdrop-blur-xl border border-slate-800 p-6 sm:p-7 rounded-3xl shadow-2xl">
                    <div class="flex justify-between items-baseline mb-1">
                        <h1 class="text-2xl font-black text-white">@CurrentAsset.Name</h1>
                        <span class="text-emerald-400 font-extrabold text-2xl ml-2">@Money.Format(CurrentPrice)</span>
                    </div>
                    <div class="flex flex-wrap items-center gap-2 text-xs text-slate-400 mb-6 pb-4 border-b border-slate-800">
                        <span>By <strong class="text-slate-300">@CurrentAsset.Creator</strong></span>
                        <span>•</span>
                        <span class="text-amber-400">★ @CurrentAsset.Rating (@CurrentAsset.ReviewCount reviews)</span>
                        <span>•</span>
                        <span>↓ @CurrentAsset.Downloads.ToString("N0")</span>
                    </div>

                    <fieldset class="space-y-3 mb-6" disabled="@IsFullyOwned">
                        <legend class="sr-only">Select License Tier</legend>

                        <label class="block p-4 rounded-2xl border-2 transition-all @(IsPersonalOwned ? "opacity-50 cursor-not-allowed" : "cursor-pointer") @(!IsCommercial ? "border-indigo-500 bg-indigo-500/10 shadow" : "border-slate-800 bg-slate-950/60 hover:border-slate-700")">
                            <div class="flex items-center justify-between mb-1">
                                <div class="flex items-center gap-2">
                                    <input type="radio" name="licenseTier" value="Personal" checked="@(!IsCommercial)" disabled="@IsPersonalOwned" @onchange="() => SelectLicense(false)" class="accent-indigo-500" />
                                    <span class="font-bold text-sm text-white">Personal License @(IsPersonalOwned ? "(Owned)" : "")</span>
                                </div>
                                <span class="text-sm font-extrabold text-white">@Money.Format(CurrentAsset.BasePrice)</span>
                            </div>
                            <p class="text-xs text-slate-400 pl-6">Single non-commercial project or game jam entry.</p>
                        </label>

                        <label class="block cursor-pointer p-4 rounded-2xl border-2 transition-all @(IsCommercial ? "border-indigo-500 bg-indigo-500/10 shadow" : "border-slate-800 bg-slate-950/60 hover:border-slate-700")">
                            <div class="flex items-center justify-between mb-1">
                                <div class="flex items-center gap-2">
                                    <input type="radio" name="licenseTier" value="Commercial" checked="@IsCommercial" @onchange="() => SelectLicense(true)" class="accent-indigo-500" />
                                    <span class="font-bold text-sm @(IsCommercial ? "text-indigo-400" : "text-white")">Commercial Unlimited</span>
                                </div>
                                <span class="text-sm font-extrabold text-emerald-400">@Money.Format(IsPersonalOwned ? CurrentAsset.BasePrice * 2 : CurrentAsset.BasePrice * 3)</span>
                            </div>
                            <p class="text-xs text-slate-400 pl-6">Unlimited commercial releases + source .ASEPRITE files.@(IsPersonalOwned ? " Upgrade price shown." : "")</p>
                        </label>
                    </fieldset>

                    @if (IsFullyOwned)
                    {
                        <a href="/vault?tab=vault"
                           class="w-full bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold py-3.5 rounded-2xl text-xs transition-all border border-slate-700 flex justify-center items-center gap-2">
                            <span>🔒</span> Asset Owned • Open in Vault
                        </a>
                    }
                    else if (Cart.IsInCart(CurrentAsset.Id))
                    {
                        <button type="button" @onclick="() => Cart.ToggleDrawer()"
                                class="w-full bg-emerald-500/20 border-2 border-emerald-500 hover:bg-emerald-500/30 text-emerald-400 font-black py-3.5 rounded-2xl transition-all shadow flex justify-center items-center gap-2">
                            In Cart • Open Drawer
                        </button>
                    }
                    else
                    {
                        <button type="button" @onclick="AddToCart"
                                class="w-full bg-indigo-600 hover:bg-indigo-500 active:scale-95 text-white font-black py-3.5 rounded-2xl shadow-lg transition-all flex justify-center items-center gap-2">
                            @(IsPersonalOwned && IsCommercial ? $"Upgrade to Commercial • {Money.Format(CurrentPrice)}" : $"Add to Cart • {Money.Format(CurrentPrice)}")
                        </button>
                    }

                    <div class="text-center mt-4">
                        <span class="text-xs text-slate-400">Instant direct download upon checkout • Verified checksum</span>
                    </div>
                </div>
            </div>
        </div>

        @if (MoreFromCreator.Count > 0)
        {
            <div class="mt-12 pt-8 border-t border-slate-800">
                <h2 class="text-lg font-bold text-white mb-4">More from @CurrentAsset.Creator</h2>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                    @foreach (var asset in MoreFromCreator)
                    {
                        <AssetCard @key="asset.Id" Item="asset" OnAddToCart="HandleAddRelated" />
                    }
                </div>
            </div>
        }

        <!-- Mobile Fixed Purchase Bar -->
        <div class="lg:hidden fixed bottom-0 inset-x-0 bg-slate-900/95 border-t border-slate-800 p-4 z-40 flex items-center justify-between backdrop-blur-lg">
            <div>
                <span class="text-xs text-slate-400 block">Total (@(IsCommercial ? "Commercial" : "Personal"))</span>
                <span class="text-lg font-black text-emerald-400">@Money.Format(CurrentPrice)</span>
            </div>
            @if (IsFullyOwned)
            {
                <a href="/vault?tab=vault" class="bg-slate-800 text-white font-bold px-4 py-2 rounded-xl text-xs">Owned</a>
            }
            else if (Cart.IsInCart(CurrentAsset.Id))
            {
                <button type="button" @onclick="() => Cart.ToggleDrawer()" class="bg-emerald-600 text-white font-bold px-4 py-2 rounded-xl text-xs">In Cart</button>
            }
            else
            {
                <button type="button" @onclick="AddToCart" class="bg-indigo-600 text-white font-bold px-4 py-2 rounded-xl text-xs shadow-md">Add to Cart</button>
            }
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private static readonly string[] Tabs = { "Overview", "Reviews", "Changelog", "FAQ" };

    private Asset? CurrentAsset;
    private bool IsCommercial { get; set; }
    private string ActiveTab { get; set; } = "Overview";
    private List<Asset> MoreFromCreator = new();
    private int _loadedId = -1;

    private bool IsFullyOwned => CurrentAsset != null && Cart.GetOwnedLicenseTier(CurrentAsset.Id) == "Commercial";
    private bool IsPersonalOwned => CurrentAsset != null && Cart.GetOwnedLicenseTier(CurrentAsset.Id) == "Personal";

    private decimal CurrentPrice
    {
        get
        {
            if (CurrentAsset == null) return 0;
            if (IsPersonalOwned && IsCommercial) return CurrentAsset.BasePrice * 2; // upgrade difference
            return IsCommercial ? CurrentAsset.BasePrice * 3 : CurrentAsset.BasePrice;
        }
    }

    protected override void OnParametersSet()
    {
        CurrentAsset = Assets.GetById(Id);
        if (CurrentAsset == null)
        {
            MoreFromCreator = new();
            return;
        }

        MoreFromCreator = Assets.GetByCreator(CurrentAsset.Creator, CurrentAsset.Id).ToList();

        if (_loadedId != Id)
        {
            _loadedId = Id;
            ActiveTab = "Overview";
            IsCommercial = IsPersonalOwned; // auto-select upgrade when a Personal license is already owned
        }
    }

    private void SelectLicense(bool commercial) => IsCommercial = commercial;

    private void AddToCart()
    {
        if (CurrentAsset == null) return;
        Cart.AddToCart(CurrentAsset, IsCommercial ? "Commercial" : "Personal", CurrentPrice);
    }

    private void HandleAddRelated(Asset asset) => Cart.AddToCart(asset);
}

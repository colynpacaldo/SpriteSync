@page "/vault"
@inject CartStateService Cart

<div class="max-w-5xl mx-auto p-6 text-slate-100 min-h-[80vh]">
    <div class="flex p-1 bg-slate-800 rounded-xl w-fit mb-10 shadow-inner">
        <button @onclick='() => ActiveTab = "Cart"' class="px-8 py-2.5 rounded-lg font-bold transition-all duration-300 @(ActiveTab == "Cart" ? "bg-indigo-600 text-white shadow-lg" : "text-slate-400 hover:text-slate-200")">
            Active Cart (@Cart.CartItems.Count)
        </button>
        <button @onclick='() => ActiveTab = "Vault"' class="px-8 py-2.5 rounded-lg font-bold transition-all duration-300 @(ActiveTab == "Vault" ? "bg-indigo-600 text-white shadow-lg" : "text-slate-400 hover:text-slate-200")">
            My Vault
        </button>
    </div>

    @if (ActiveTab == "Cart")
    {
        <div class="bg-slate-900 border border-slate-800 rounded-3xl p-8 shadow-2xl">
            <h2 class="text-3xl font-extrabold mb-8 border-b border-slate-800 pb-4 text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 to-cyan-400">Checkout Summary</h2>
            
            @if(Cart.CartItems.Any())
            {
                <EditForm Model="CheckoutModel" OnValidSubmit="ProcessCheckout">
                    <DataAnnotationsValidator />
                    
                    <div class="space-y-4 mb-8">
                        @foreach(var item in Cart.CartItems)
                        {
                            <div class="flex justify-between items-center bg-slate-800/50 border border-slate-700 p-5 rounded-2xl">
                                <span class="font-medium text-lg">@item.Name</span>
                                <span class="text-emerald-400 font-black text-lg">$@item.BasePrice</span>
                            </div>
                        }
                        
                        <div class="flex justify-between items-center p-5 pt-8 border-t border-slate-800">
                            <span class="text-xl font-medium text-slate-400">Total</span>
                            <span class="text-3xl font-black text-white">$@Cart.CartItems.Sum(x => x.BasePrice)</span>
                        </div>
                    </div>

                    <div class="flex flex-col md:flex-row gap-4 items-start">
                        <div class="w-full">
                            <InputText @bind-Value="CheckoutModel.Email" placeholder="Email Address for receipt..." class="w-full bg-slate-800 border border-slate-700 rounded-xl px-5 py-4 focus:border-indigo-500 outline-none text-lg transition-colors" />
                            <ValidationMessage For="@(() => CheckoutModel.Email)" class="text-rose-500 text-sm mt-2 font-medium" />
                        </div>
                        <button type="submit" class="w-full md:w-auto bg-emerald-600 hover:bg-emerald-500 px-10 py-4 rounded-xl font-black text-lg transition-all active:scale-95 whitespace-nowrap shadow-[0_0_20px_rgba(16,185,129,0.3)]">
                            Pay Securely
                        </button>
                    </div>
                </EditForm>
            }
            else
            {
                <div class="text-center py-20">
                    <svg class="w-20 h-20 text-slate-700 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                    <p class="text-slate-400 text-xl font-medium">Your cart is feeling a bit empty.</p>
                </div>
            }
        </div>
    }
    else if (ActiveTab == "Vault")
    {
        <div class="bg-slate-900 border border-slate-800 rounded-3xl overflow-hidden shadow-2xl">
            <div class="overflow-x-auto">
                <table class="w-full text-left">
                    <thead class="bg-slate-800/80 text-slate-300">
                        <tr>
                            <th class="px-8 py-5 font-bold tracking-wider text-sm uppercase">Purchased Asset</th>
                            <th class="px-8 py-5 font-bold tracking-wider text-sm uppercase">License</th>
                            <th class="px-8 py-5 font-bold tracking-wider text-sm uppercase">Version</th>
                            <th class="px-8 py-5 font-bold tracking-wider text-sm uppercase text-right">Action</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-800/50">
                        <tr class="hover:bg-slate-800/30 transition-colors group">
                            <td class="px-8 py-6 flex items-center gap-4">
                                <div class="w-12 h-12 bg-indigo-500/20 border border-indigo-500/30 rounded-xl flex-shrink-0 flex items-center justify-center text-indigo-400">
                                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                                </div>
                                <span class="font-bold text-lg">Fantasy Tileset Pro</span>
                            </td>
                            <td class="px-8 py-6">
                                <span class="bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 px-4 py-1.5 rounded-full text-xs font-black tracking-widest">COMMERCIAL</span>
                            </td>
                            <td class="px-8 py-6 text-slate-400 text-sm font-medium">v1.2 (Added jump frames)</td>
                            <td class="px-8 py-6 text-right">
                                <button class="bg-indigo-600/10 text-indigo-400 border border-indigo-500/30 hover:bg-indigo-600 hover:text-white px-5 py-2.5 rounded-xl text-sm font-bold transition-all flex items-center gap-2 ml-auto group-hover:shadow-[0_0_15px_rgba(99,102,241,0.4)]">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                                    Download .ZIP
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private string ActiveTab = "Cart";
    private CheckoutForm CheckoutModel = new();

    protected override void OnInitialized() => Cart.OnChange += StateHasChanged;
    public void Dispose() => Cart.OnChange -= StateHasChanged;

    private void ProcessCheckout()
    {
        Cart.ClearCart();
        ActiveTab = "Vault";
    }

    public class CheckoutForm
    {
        [Required, EmailAddress]
        public string Email { get; set; } = "";
    }
}
@implements IDisposable
@inject ToastService Toast

<div class="fixed bottom-4 right-4 z-[60] space-y-2" aria-live="polite" role="status">
    @foreach (var t in Toast.Messages)
    {
        <div class="px-4 py-2.5 rounded-xl text-xs font-bold shadow-xl border @(t.Kind == "error" ? "bg-rose-600 border-rose-400 text-white" : t.Kind == "success" ? "bg-emerald-600 border-emerald-400 text-white" : "bg-slate-800 border-slate-600 text-slate-100")">
            @t.Text
        </div>
    }
</div>

@code {
    protected override void OnInitialized() => Toast.OnChange += Refresh;
    private void Refresh() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Toast.OnChange -= Refresh;
}

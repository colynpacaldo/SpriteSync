@inject CartStateService Cart

<div class="group bg-slate-800/80 rounded-2xl border transition-all duration-300 flex flex-col overflow-hidden relative @(IsInCart ? "border-emerald-500/60 shadow-[0_0_20px_rgba(16,185,129,0.15)] ring-1 ring-emerald-500/30" : "border-slate-700 hover:border-indigo-500 hover:shadow-[0_0_20px_rgba(99,102,241,0.2)]")">
    @if (IsInCart)
    {
        <div class="absolute top-3 right-3 z-20 bg-emerald-500 text-slate-950 font-black text-xs px-2.5 py-1 rounded-full shadow-lg flex items-center gap-1.5 animate-in fade-in zoom-in duration-200">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
            IN CART
        </div>
    }

    <a href="/asset/@Item.Id" class="overflow-hidden bg-[#161f30] aspect-video flex items-center justify-center relative cursor-pointer">
        <img src="@Item.ImageUrl" alt="@Item.Name" 
             class="transform group-hover:scale-105 transition-transform duration-300 object-cover w-full h-full opacity-90 group-hover:opacity-100" 
             style="image-rendering: pixelated;" />
        <div class="absolute inset-0 bg-gradient-to-t from-slate-900/90 via-transparent to-transparent"></div>
        <span class="absolute bottom-2 left-3 text-xs text-indigo-300 font-medium bg-slate-900/80 px-2 py-0.5 rounded backdrop-blur-sm">@Item.ArtStyle</span>
    </a>
    
    <div class="p-5 flex flex-col flex-grow">
        <div class="flex justify-between items-start mb-1">
            <a href="/asset/@Item.Id" class="font-bold text-lg hover:text-indigo-400 transition-colors line-clamp-1">@Item.Name</a>
            <span class="text-emerald-400 font-black text-lg ml-2">$@Item.BasePrice</span>
        </div>
        
        <div class="flex items-center gap-2 mb-3 text-xs text-slate-400">
            <span>@Item.Creator</span>
            <span>•</span>
            <span class="text-amber-400 font-semibold flex items-center gap-1">
                ★ @Item.Rating <span class="text-slate-500 font-normal">(@Item.ReviewCount)</span>
            </span>
        </div>
        
        <div class="flex gap-1.5 mb-5 flex-wrap">
            @foreach(var format in Item.Formats)
            {
                <span class="text-[11px] bg-slate-900/60 border border-slate-700 text-slate-300 px-2 py-0.5 rounded font-mono">@format</span>
            }
        </div>

        <div class="mt-auto">
            @if (IsInCart)
            {
                <button @onclick="() => Cart.ToggleDrawer()" 
                        class="w-full bg-emerald-500/10 border border-emerald-500/40 hover:bg-emerald-500/20 text-emerald-400 font-bold py-2.5 rounded-xl transition-all flex items-center justify-center gap-2">
                    <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
                    In Cart • View Drawer
                </button>
            }
            else
            {
                <button @onclick="() => OnAddToCart.InvokeAsync(Item)" 
                        class="w-full bg-indigo-600 hover:bg-indigo-500 active:scale-95 text-white font-bold py-2.5 rounded-xl transition-all shadow-lg flex items-center justify-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                    Add to Cart
                </button>
            }
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public Asset Item { get; set; } = new();
    [Parameter] public EventCallback<Asset> OnAddToCart { get; set; }

    private bool IsInCart => Cart.IsInCart(Item.Id);
}

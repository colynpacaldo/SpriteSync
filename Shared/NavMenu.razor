@inject CartStateService Cart
@implements IDisposable

<nav class="bg-slate-950/80 backdrop-blur-md border-b border-slate-800/80 px-6 py-3.5 sticky top-0 z-50">
    <div class="max-w-7xl mx-auto flex justify-between items-center">
        <!-- Logo & Tagline -->
        <div class="flex items-center gap-6">
            <a href="/" class="flex items-center gap-2.5 group">
                <div class="w-8 h-8 rounded-lg bg-gradient-to-tr from-indigo-600 to-cyan-400 flex items-center justify-center font-black text-white text-base shadow-[0_0_15px_rgba(99,102,241,0.4)]">
                    S
                </div>
                <div>
                    <span class="text-xl font-black tracking-tight text-white group-hover:text-indigo-400 transition-colors">SpriteSync</span>
                    <span class="hidden sm:inline-block ml-2 text-[10px] uppercase font-bold tracking-widest text-slate-400 border border-slate-800 px-1.5 py-0.5 rounded">Storefront</span>
                </div>
            </a>
            
            <div class="hidden md:flex items-center gap-1 text-sm font-medium">
                <a href="/" class="text-slate-300 hover:text-white px-3 py-1.5 rounded-lg hover:bg-slate-800/60 transition-colors">Marketplace</a>
                <a href="/vault" class="text-slate-300 hover:text-white px-3 py-1.5 rounded-lg hover:bg-slate-800/60 transition-colors">My Vault & Licenses</a>
            </div>
        </div>

        <!-- Right Side: User Profile & Cart Button -->
        <div class="flex items-center gap-3">
            <!-- User Status Pill -->
            <a href="/vault" class="hidden sm:flex items-center gap-2.5 bg-slate-900 border border-slate-800 hover:border-slate-700 px-3 py-1.5 rounded-full transition-colors">
                <span class="text-sm">@Cart.User.Avatar</span>
                <span class="text-xs font-semibold text-slate-200">@Cart.User.Handle</span>
                <span class="text-[10px] bg-indigo-500/20 text-indigo-300 font-mono px-1.5 py-0.5 rounded-full">@Cart.User.AssetsOwned owned</span>
            </a>

            <!-- Cart Trigger -->
            <button @onclick="() => Cart.ToggleDrawer()" 
                    class="bg-indigo-600/10 hover:bg-indigo-600/20 border border-indigo-500/30 text-indigo-300 px-3.5 py-1.5 rounded-full flex items-center gap-2 transition-all active:scale-95 text-xs font-bold">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
                <span>Cart</span>
                @if (Cart.CartItems.Any())
                {
                    <span class="bg-indigo-500 text-white text-[10px] font-black px-1.5 py-0.2 rounded-full">
                        @Cart.CartItems.Count
                    </span>
                }
            </button>
        </div>
    </div>
</nav>

@code {
    protected override void OnInitialized() => Cart.OnChange += StateHasChanged;
    public void Dispose() => Cart.OnChange -= StateHasChanged;
}

@inject CartStateService Cart
@implements IDisposable

<nav class="bg-slate-900/80 backdrop-blur-md border-b border-slate-800 p-4 sticky top-0 z-50 shadow-lg">
    <div class="max-w-7xl mx-auto flex justify-between items-center">
        <a href="/" class="text-2xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 to-cyan-400 hover:scale-105 transition-transform duration-200">
            SpriteSync
        </a>
        <div class="flex gap-6 items-center font-medium">
            <a href="/" class="text-slate-300 hover:text-indigo-400 transition-colors">Market</a>
            <a href="/vault" class="text-slate-300 hover:text-indigo-400 transition-colors">My Vault</a>
            
            <a href="/vault" class="bg-slate-800 hover:bg-slate-700 border border-slate-700 px-4 py-2 rounded-xl flex items-center gap-3 transition-colors shadow-sm">
                <span class="text-sm">Cart</span>
                @if (Cart.CartItems.Any())
                {
                    <span class="bg-indigo-500 text-white text-xs font-bold px-2 py-1 rounded-full animate-pulse">
                        @Cart.CartItems.Count
                    </span>
                }
            </a>
        </div>
    </div>
</nav>

@code {
    protected override void OnInitialized() => Cart.OnChange += StateHasChanged;
    public void Dispose() => Cart.OnChange -= StateHasChanged;
}
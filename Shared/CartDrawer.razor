@inject CartStateService Cart
@inject NavigationManager Nav
@implements IDisposable

@if (Cart.IsDrawerOpen)
{
    <div class="fixed inset-0 bg-slate-950/70 backdrop-blur-sm z-50 transition-opacity" @onclick="() => Cart.CloseDrawer()"></div>
}

<aside class="fixed inset-y-0 right-0 max-w-full w-full sm:w-96 bg-slate-900 border-l border-slate-800 shadow-2xl z-50 transform transition-transform duration-300 ease-in-out flex flex-col @(Cart.IsDrawerOpen ? "translate-x-0" : "translate-x-full")">
    <div class="p-5 border-b border-slate-800 flex justify-between items-center bg-slate-900/50">
        <div class="flex items-center gap-2">
            <h2 class="text-xl font-bold text-white">Your Cart</h2>
            <span class="bg-indigo-500/20 text-indigo-400 text-xs font-bold px-2 py-0.5 rounded-full">@Cart.CartItems.Count items</span>
        </div>
        <button @onclick="() => Cart.CloseDrawer()" class="text-slate-400 hover:text-white p-2 rounded-lg hover:bg-slate-800 transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
    </div>

    <div class="flex-1 overflow-y-auto p-5 space-y-4">
        @if (Cart.CartItems.Any())
        {
            @foreach (var item in Cart.CartItems)
            {
                <div class="flex gap-4 p-3 bg-slate-800/60 rounded-xl border border-slate-700/60 relative group">
                    <div class="w-16 h-16 bg-slate-900 rounded-lg overflow-hidden flex-shrink-0 flex items-center justify-center">
                        <img src="@item.Asset.ImageUrl" alt="@item.Asset.Name" class="w-full h-full object-cover" style="image-rendering: pixelated;" />
                    </div>
                    <div class="flex-1 min-w-0">
                        <h4 class="font-bold text-sm text-slate-100 truncate">@item.Asset.Name</h4>
                        <div class="flex items-center gap-2 mt-1">
                            <span class="text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded bg-indigo-500/20 text-indigo-300 border border-indigo-500/30">
                                @item.LicenseTier
                            </span>
                        </div>
                        <div class="mt-2 text-emerald-400 font-extrabold text-sm">@Money.Format(item.Price)</div>
                    </div>
                    <button @onclick="() => Cart.RemoveFromCart(item.Asset.Id)" class="text-slate-500 hover:text-rose-400 transition-colors self-start p-1">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                    </button>
                </div>
            }
        }
        else
        {
            <div class="text-center py-16 text-slate-500">
                <svg class="w-12 h-12 mx-auto mb-3 opacity-40" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
                <p class="font-medium">Your cart is empty</p>
                <p class="text-xs text-slate-600 mt-1">Browse the market and add assets!</p>
            </div>
        }
    </div>

    @if (Cart.CartItems.Any())
    {
        <div class="p-5 border-t border-slate-800 bg-slate-900/90 space-y-3">
            <div class="flex justify-between items-center text-slate-300 text-sm">
                <span>Subtotal</span>
                <span class="font-bold text-white text-base">@Money.Format(Cart.Subtotal)</span>
            </div>
            <button @onclick="GoToCheckout" class="w-full bg-emerald-600 hover:bg-emerald-500 active:scale-95 text-white font-extrabold py-3.5 rounded-xl shadow-lg transition-all flex items-center justify-center gap-2">
                Proceed to Vault Checkout
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
            </button>
        </div>
    }
</aside>

@code {
    protected override void OnInitialized() => Cart.OnChange += StateHasChanged;
    public void Dispose() => Cart.OnChange -= StateHasChanged;

    private void GoToCheckout()
    {
        Cart.CloseDrawer();
        // Navigates directly with ?tab=checkout query
        Nav.NavigateTo("/vault?tab=checkout");
    }
}
